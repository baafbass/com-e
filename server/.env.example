# Server
NODE_ENV=development
PORT=5000

# Neon PostgreSQL connection string (Dashboard > Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Maximum simultaneous database connections
DB_POOL_MAX=10

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@shopsphere.com
ADMIN_PASSWORD=Admin@1234
